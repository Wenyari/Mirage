# 前端环境变量示例
# 复制为 .env.local 后填入真实值：cp .env.example .env.local
#
# ⚠️  VITE_ 前缀的变量会被打包进前端产物，浏览器可见。
#     仅存放公开标识（如验证码的 public ID），绝不要放任何 secret key。

# 后端 API 地址
VITE_API_BASE_URL=/api

# 极验 Geetest 4.0 —— 仅 ID，KEY 在后端 .env 中配置
VITE_GEETEST_ID=your-geetest-id

# Cloudflare Turnstile —— 仅 site key，secret key 在后端 .env 中配置
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
