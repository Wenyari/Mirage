# ============================================================
# Mirage 环境变量示例
# 复制为 .env 后填入真实值：cp .env.example .env
#
# ⚠️  .env 已被 .gitignore 忽略，请勿将真实凭据写入本文件并提交。
#     所有密钥请使用随机生成的强值，切勿复用示例占位符。
# ============================================================

# ------------------------------------------------------------
# Flask 基础配置
# ------------------------------------------------------------
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-random-secret-key

# ------------------------------------------------------------
# JWT 配置
# ------------------------------------------------------------
JWT_SECRET_KEY=replace-with-random-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=604800

# ------------------------------------------------------------
# MySQL 配置
# ------------------------------------------------------------
MYSQL_DATABASE=mirage
MYSQL_USER=mirage_user
MYSQL_PASSWORD=your-mysql-password
MYSQL_ROOT_PASSWORD=your-mysql-root-password

# ------------------------------------------------------------
# Redis 配置
# ------------------------------------------------------------
REDIS_PASSWORD=your-redis-password

# ------------------------------------------------------------
# 连接字符串
# 主机名 mysql / redis 对应 docker-compose 中的 service name
# 本地直连开发时改为 localhost
# ------------------------------------------------------------
DATABASE_URI=mysql+pymysql://mirage_user:${MYSQL_PASSWORD}@mysql:3306/mirage?charset=utf8mb4
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ------------------------------------------------------------
# 邮件配置 (SMTP，用于发送注册验证码)
# ------------------------------------------------------------
MAIL_SERVER=smtp.example.com
MAIL_PORT=465
MAIL_USE_SSL=True
MAIL_USE_TLS=False
MAIL_USERNAME=noreply@your-domain.com
# 建议使用邮箱服务商提供的「客户端专用密码」，而非账号主密码
MAIL_PASSWORD=your-smtp-password
MAIL_DEFAULT_SENDER=noreply@your-domain.com

# ------------------------------------------------------------
# 上游 AI 生成 API
# 实际密钥建议在管理后台「密钥池」中配置，支持多密钥负载均衡
# ------------------------------------------------------------
OPENAI_API_KEY=sk-your-upstream-api-key
SORA_API_BASE_URL=https://your-upstream-provider.com
SORA_API_ENDPOINT=https://your-upstream-provider.com/v2/videos/generations

# ------------------------------------------------------------
# Cloudflare R2 对象存储 (S3 兼容)
# ------------------------------------------------------------
R2_ACCOUNT_ID=your-r2-account-id
R2_TOKEN_VALUE=your-r2-api-token
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-public-bucket-domain

# ------------------------------------------------------------
# 人机验证 (二选一或同时启用)
# ------------------------------------------------------------
# 极验 Geetest 4.0 —— GEETEST_ID 会下发到前端，GEETEST_KEY 必须保密
GEETEST_ID=your-geetest-id
GEETEST_KEY=your-geetest-key

# Cloudflare Turnstile —— SECRET_KEY 必须保密
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ------------------------------------------------------------
# 初始管理员账号 (仅 init_db.py 首次初始化时使用)
# 首次登录后请立即修改密码
# ------------------------------------------------------------
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=your-admin-password

# ------------------------------------------------------------
# 限流
# ------------------------------------------------------------
RATE_LIMIT_PER_HOUR=100
