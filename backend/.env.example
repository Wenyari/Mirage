# Flask 基础配置
SECRET_KEY=dev-secret-key-change-in-production-2024
FLASK_ENV=development

# JWT 配置
JWT_SECRET_KEY=jwt-secret-key-change-in-production-2024
JWT_ACCESS_TOKEN_EXPIRES=604800

# ====================
# 数据库配置
# ====================
# 本地开发环境 (直接运行)
DATABASE_URI=mysql+pymysql://root:admin@localhost:3306/sora_platform?charset=utf8mb4

# Docker 环境 (docker-compose 会自动设置，无需手动修改)
# DATABASE_URI=mysql+pymysql://sora_user:sora_password@mysql:3306/sora_platform?charset=utf8mb4

# MySQL 密码配置 (用于 docker-compose)
MYSQL_ROOT_PASSWORD=root_password
MYSQL_PASSWORD=sora_password

# ====================
# Redis 配置
# ====================
# 本地开发环境
REDIS_URL=redis://localhost:6379/0

# Docker 环境 (docker-compose 会自动设置)
# REDIS_URL=redis://redis:6379/0

# 邮件配置 (腾讯企业邮SMTP)
MAIL_SERVER=smtp.exmail.qq.com  # 替换为腾讯企业邮的SMTP服务器
MAIL_PORT=465                   # 替换为SSL加密端口（对应你截图中的465）
MAIL_USE_SSL=True
MAIL_USE_TLS=False
MAIL_USERNAME=noreply@example.com # 替换为你的企业邮账号
MAIL_PASSWORD=***REMOVED*** # 替换为邮箱密码（若提示错误，用客户端专用密码）
MAIL_DEFAULT_SENDER=noreply@example.com

# 第三方 Sora API 配置
OPENAI_API_KEY=***REMOVED***
SORA_API_BASE_URL=https://ai.t8star.cn
SORA_API_ENDPOINT=https://ai.t8star.cn/v2/videos/generations

# Rate Limiting
RATE_LIMIT_PER_HOUR=100

# Admin Configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Cloudflare R2 对象存储配置
R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here
R2_BUCKET_NAME=mirage-storage
R2_PUBLIC_URL=https://cdn.yourdomain.com  # 自定义域名（可选）

# Cloudflare Turnstile 配置
TURNSTILE_SECRET_KEY=0x4AAAAAACLPiTaeyrxt7V8OqfOtajimoCk
